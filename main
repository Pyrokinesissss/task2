import java.util.Array;
import java.util.Scanner;

public class main {
    public static void main(String[] args) {
        int[] numbers = {10, 20, 30, 40, 50};
        System.out.println("Массив:");
        System.out.println(numbers.length);

        Scanner scanner = new Scanner(System.in);

        System.out.print("Выбор: (1 добавить, 2 удалить): ");
        int choice = scanner.nextInt();
        if (choice != 1 && choice != 2) {
            System.out.println("Неверный выбор. Введите 1 или 2");
        }
        else if (choice == 1) {
            System.out.print("Введите число для добавления: ");
            int newNum = scanner.nextInt();
            int[] newNumbers = new int[numbers.length + 1];
            for (int i = 0; i < numbers.length; i++) {
                newNumbers[i] = numbers[i];
                numbers.add(newNum);
            System.out.println(numbers);
        }
        else {
            System.out.print("Введите индекс от 0 до 4 для удаления: ");
            int index = scanner.nextInt();
            if (index < 0 || index > numbers.size) {
                System.out.println("Ошибка");
            } else {
               for (int i = 0; i < numbers.size(); i++) {
                    if (i == index) {
                        numbers.remove(i);
              System.out.println(numbers);
                    }
                }
            }
        }

        scanner.close();
    }
}


import java.util.Random;
import java.util.Scanner


public class dasd {
    public static void main(String[] args) {
        Random random = new Random();
        Scanner scanner = new Scanner(System.in);


        int newNumb = random.nextInt(100) + 1;

        int maxAttempts = 10;
        int attempts = 0;

        System.out.println("Я загадал число от 1 до 100.");

        while (attempts < maxAttempts) {
            System.out.print("Введите ваше предположение: ");

            int guess = scanner.nextInt();
            attempts++;


            if (guess < 1 || guess > 100) {
                System.out.println("Ошибка: число должно быть в диапазоне от 1 до 100");
                attempts--;
                continue;
            }

            if (guess < newNumb) {
                System.out.println("Моё число больше");
            } else if (guess > newNumb) {
                System.out.println("Моё число меньше");
            } else {
                System.out.println("Поздравляю! Вы угадали!");
                System.out.println("Вы угадали за " + attempts + " попыток");
                scanner.close();
                return; 
            }
        }


        System.out.println("Загаданное число было: " + secretNumber);
        scanner.close();
    }
}
